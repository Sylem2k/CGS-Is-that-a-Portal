// EXPERIMENTAL render-to-mesh material for the BLUE/ORANGE frame view planes.
// Reforger PIP sights use the same $rendertarget binding.
// The output is generated LOCALLY, not sent across the network.
MatPBRBasic {
 Emissive 1 1 1 0
 EmissiveLV -3.429
 ApplyAlbedoToEmissive 1
 Cull none
 Specular 0 0 0 1
 BCRMap "$rendertarget"
}
